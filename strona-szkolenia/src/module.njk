---
layout: base.njk
page_type: module
pagination:
  data: collections.modules
  size: 1
  alias: moduleEntry
permalink: "materials/{{ moduleEntry.data.slug }}/index.html"
eleventyComputed:
  title: "Moduł {{ moduleEntry.data.number }}: {{ moduleEntry.data.title }}"
  description: "{{ moduleEntry.data.goal }}"
---
{% set item = moduleEntry %}
{% set material = collections.materials | materialFor(item.data.number) %}
<section class="detail-hero" aria-labelledby="detail-title">
  <div class="container detail-hero-grid">
    <div>
      <a class="button button-secondary detail-return" href="/#{{ item.data.slug }}" data-course-link><span aria-hidden="true">←</span> Wróć do modułu {{ item.data.number }}</a>
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Moduł {{ item.data.number | pad2 }} / 08</p>
      <h1 id="detail-title">{{ item.data.title }}</h1>
      <p class="detail-lead">{{ item.data.theory }}</p>
      <div class="detail-goal"><span class="small-label">Cel modułu</span><p>{{ item.data.goal }}</p></div>
    </div>
    <aside class="detail-time-card" aria-label="Czas modułu">
      <div data-participant-time>
        <span class="small-label">Czas modułu</span>
        <strong>{{ item.data.duration }} <span>minut</span></strong>
        <p>Teoria {{ item.data.breakdown.theory }} · pokaz {{ item.data.breakdown.demonstration }} · ćwiczenie {{ item.data.breakdown.exercise }} · refleksja {{ item.data.breakdown.reflection }}</p>
      </div>
      <div class="timer" data-timer data-duration="{{ item.data.duration }}" data-module-number="{{ item.data.number }}" data-presenter-only hidden>
        <span class="small-label">Pozostały czas</span>
        <time data-timer-display datetime="PT{{ item.data.duration }}M" aria-live="off">{{ item.data.duration }}:00</time>
        <p class="timer-status" data-timer-status role="status" aria-live="polite">Gotowy do rozpoczęcia</p>
        <div class="timer-actions">
          <button class="button button-primary" type="button" data-timer-toggle>Start</button>
          <button class="button button-secondary" type="button" data-timer-reset>Reset</button>
        </div>
        <p class="timer-breakdown">Teoria {{ item.data.breakdown.theory }} · pokaz {{ item.data.breakdown.demonstration }} · ćwiczenie {{ item.data.breakdown.exercise }} · refleksja {{ item.data.breakdown.reflection }}</p>
      </div>
    </aside>
  </div>
</section>

<article class="detail-article">
  <section class="reading-section participant-material" aria-labelledby="theory-title">
    <p class="section-number">Materiały / Teoria rozszerzona</p>
    <h2 id="theory-title">Pogłębienie tematu</h2>
    <div class="prose">{{ material.content | safe }}</div>
  </section>

  <aside class="closing-principle" aria-label="Dobra praktyka modułu {{ item.data.number }}">
    <span class="small-label">Dobra praktyka</span>
    <p>{{ item.data.principle }}</p>
  </aside>
</article>
